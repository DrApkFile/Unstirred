<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>A second room</title>
  </head>
  <body>
    <template>
      <style>
        #root {
          position: absolute;
          inset: 0;
          background: var(--paper);
        }

        #s7-term {
          top: 230px;
          height: 539px;
        }

        #s7-browser {
          top: 8px;
          height: 986px;
        }

      </style>

      <div id="root" data-composition-id="s7-second-room" data-width="1920" data-height="1080">
        <div class="window" id="s7-term">
          <div class="window-bar">
            <div class="window-lamps"><i></i><i></i><i></i></div>
            <div class="window-name" data-layout-ignore>the holder's terminal</div>
            <div class="window-prov" data-layout-ignore>re-enactment of a recorded testnet run · evidence/2026-10-20-two-room-knock.txt</div>
          </div>
          <div class="term-body" data-layout-ignore>
            <!-- prettier-ignore-start -->
            <span class="line line-cmd" data-at="0" data-type="1.1" data-cursor="1">$ $U knock --gate http://127.0.0.1:8080 --room second-room --wallet "$W" \</span>
            <span class="line line-cut" data-at="1.2" data-type="0.35" data-cursor="1">    …                                            the same flags, the same coins, a second room</span>
            <span class="line line-key" data-at="1.65">gate          http://127.0.0.1:8080</span>
            <span class="line line-key" data-at="1.75" id="s7-room">room          second-room</span>
            <span class="line line-key" data-at="1.85">network       test</span>
            <span class="line line-key" data-at="1.95">window        h0 4505790 through h1 4506510</span>
            <span class="line line-key" data-at="2.05">threshold     12500000 zatoshis</span>
            <span class="line line-key" data-at="2.25">challenge     issued by the gate, expires 2026-10-20T15:25:48Z</span>
            <span class="line" data-at="2.45">proving now; this takes seconds and reveals nothing to the gate but the package</span>
            <span class="line line-cut" data-at="2.95">                                                               — cut —</span>
            <span class="line line-admit" data-at="3.5" id="s7-verdict">ADMITTED</span>
            <span class="line" data-at="4.0">the gate was sent one package proving 1 note(s) held unmoved across the window, and nothing else</span>
            <span class="line" data-at="4.3" data-cursor="1">$ </span>
            <!-- prettier-ignore-end -->
            <span class="cursor-block"></span>
          </div>
        </div>

        <div class="browser" id="s7-browser">
          <div class="window-bar">
            <div class="window-lamps"><i></i><i></i><i></i></div>
            <div class="url" data-layout-ignore>127.0.0.1:8080/room/second-room?replay=act5-second-room&amp;present=1</div>
            <div class="window-prov" data-layout-ignore>re-enactment of a recorded testnet run · evidence/2026-10-20-two-room-knock.txt</div>
          </div>
          <div class="viewport">
            <div class="viewport-world" id="s7-world">
              <iframe class="page-frame" src="assets/site/act5-second-room.present.html" title="Holders' Room, act 5"></iframe>
            </div>
            <div class="spotlight" id="s7-spot"></div>
            <div class="pointer" id="s7-pointer">
              <svg viewBox="0 0 26 26" aria-hidden="true">
                <path
                  d="M3 2 L3 20 L8 15.5 L11.2 23 L14.8 21.4 L11.7 14.2 L18.5 13.8 Z"
                  fill="#edeff3"
                  stroke="#0d0f13"
                  stroke-width="1.4"
                  stroke-linejoin="round"
                />
              </svg>
              <div class="ripple"></div>
            </div>
          </div>
        </div>

      </div>

      <script>
        (function () {
          var tl = gsap.timeline({ paused: true });
          var CUT = 4.6;

          film.terminal(tl, document.getElementById("s7-term"), CUT);
          film.camera(tl, document.getElementById("s7-world"), []);

          var term = document.getElementById("s7-term");
          var browser = document.getElementById("s7-browser");

          gsap.set(browser, { opacity: 0 });

          /* The one word that changed from the last knock. */
          tl.fromTo(
            document.getElementById("s7-room"),
            { color: "#8fbcf2" },
            { color: "#868e9d", duration: 1.1, ease: "power2.out" },
            1.85
          );
          tl.fromTo(
            document.getElementById("s7-verdict"),
            { scale: 1.12, opacity: 0 },
            { scale: 1, opacity: 1, duration: 0.34, ease: "back.out(2.2)", transformOrigin: "0% 50%" },
            3.5
          );

          tl.to(term, { opacity: 0, duration: 0.35, ease: "power2.in" }, CUT - 0.35);
          tl.fromTo(
            browser,
            { opacity: 0, scale: 0.985 },
            { opacity: 1, scale: 1, duration: 0.5, ease: "power2.out" },
            CUT
          );

          film.pointer(tl, document.getElementById("s7-pointer"), [
            { at: CUT + 0.3, dur: 1.3, from: [1340, 800], to: [703, 699] }
          ]);

          /* Two marker sets and the line that counts what they share. */
          film.spotlight(tl, document.getElementById("s7-spot"), [660, 640, 700, 290], CUT + 1.7, 0.55);

          window.__timelines["s7-second-room"] = tl;
        })();
      </script>
    </template>
  </body>
</html>
